# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Para desarrollo local puedes usar:
# - Docker: docker run -e POSTGRES_PASSWORD=password -p 5432:5432 postgres
# - Supabase: https://supabase.com
# - Neon: https://neon.tech
# - Vercel Postgres: https://vercel.com/storage/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/turnosweb?schema=public"

# ===========================================
# NEXTAUTH
# ===========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# MERCADOPAGO (Requerido para suscripciones)
# ===========================================
# Access token del vendedor (producción o sandbox).
# Obtenerlo en: https://www.mercadopago.com.ar/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=""
# Secret para verificar la firma HMAC de los webhooks.
# Configurarlo en: https://www.mercadopago.com.ar/developers/panel/webhooks
MERCADOPAGO_WEBHOOK_SECRET=""

# ===========================================
# STRIPE (Optional - for payments)
# ===========================================
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ===========================================
# EMAIL (Optional - for notifications)
# ===========================================
# RESEND_API_KEY=""

